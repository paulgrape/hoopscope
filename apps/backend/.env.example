# Server
PORT=3000
FRONTEND_URL=http://localhost:3001

# Logging: trace|debug|info|warn|error|fatal|silent (default info in production, debug otherwise)
# LOG_LEVEL=debug

# Historic game replay
HISTORIC_GAME_TICK_MS=1000

# NBA season used when a request does not specify one
NBA_DEFAULT_SEASON=2025-26

# Upstream API base URLs (defaults baked in; override only if needed)
# ESPN_BASE_URL=https://site.api.espn.com/apis/site/v2/sports/basketball/nba
# ESPN_WEB_API_BASE_URL=https://site.web.api.espn.com/apis/common/v3/sports/basketball/nba
# ESPN_CORE_BASE_URL=https://sports.core.api.espn.com/v2/sports/basketball/leagues/nba
# ESPN_NOW_API_URL=https://api-app.espn.com/allsports/apis/v1/now
# ESPN_STANDINGS_BASE_URL=https://site.api.espn.com/apis/v2/sports/basketball

# Upstream resilience tuning
# ESPN_RETRY_ATTEMPTS=3
# ESPN_RETRY_BASE_DELAY_MS=500
# ESPN_RETRY_MAX_DELAY_MS=8000
# ESPN_MAX_CONCURRENCY=5
# ESPN_REQUEST_GAP_MS=0
