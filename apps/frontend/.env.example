# Backend API (browser-visible; also used for the Socket.IO replay connection)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Optional server-side backend URL override (e.g. internal network address)
# API_URL=http://backend:3000

# Absolute URL base for SEO (sitemap, OG tags, JSON-LD, RSS)
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Analytics (loaded in production builds only)
# GTM_ID=GTM-XXXXXXX
